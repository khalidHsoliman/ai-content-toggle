{
  "manifest_version": 3,
  "name": "AI Content Toggle",
  "version": "1.0",
  "description": "Hide LinkedIn posts that on-device models flag as AI-generated.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.licdn.com/*",
    "https://huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Toggle AI content" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
